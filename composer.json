{
  "name": "multidigital/rashel-hanukkah",
  "description": "RASHEL Digital School Hanukkah landing page: WordPress theme. Composer holds development tools only; nothing here ships to production.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "1.1.2",
    "php-stubs/wordpress-stubs": "7.1.0",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "phpstan/phpstan": "2.3.6",
    "phpunit/phpunit": "9.6.38",
    "szepeviktor/phpstan-wordpress": "2.0.4",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.6"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=2G --no-progress",
    "test": "phpunit",
    "audit:deps": "composer audit --locked"
  }
}
