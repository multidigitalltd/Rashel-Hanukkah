<?xml version="1.0"?>
<ruleset name="Rashel Hanukkah theme">
	<description>WordPress Coding Standards for the Rashel Hanukkah theme (standard section 16.1.3).</description>

	<file>rashel-hanukkah</file>
	<file>bin</file>
	<file>tests</file>

	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.3-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rashel-hanukkah"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rsh"/>
				<element value="RSH"/>
			</property>
		</properties>
	</rule>

	<!-- "rsh" is the theme's prefix; every global it adds starts with rsh_ or RSH_. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed">
		<severity>0</severity>
	</rule>

	<!-- The lead post type's own capabilities (inc/leads-crm.php). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_rsh_leads"/>
				<element value="edit_others_rsh_leads"/>
				<element value="edit_published_rsh_leads"/>
				<element value="edit_private_rsh_leads"/>
				<element value="publish_rsh_leads"/>
				<element value="read_private_rsh_leads"/>
				<element value="delete_rsh_leads"/>
				<element value="delete_others_rsh_leads"/>
				<element value="delete_published_rsh_leads"/>
				<element value="delete_private_rsh_leads"/>
			</property>
		</properties>
	</rule>

	<!-- Command-line tools and tests: no WordPress around them, so its file, output and naming rules do not apply. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>bin/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>bin/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<exclude-pattern>tests/e2e/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
